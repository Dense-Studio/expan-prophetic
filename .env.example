# Supabase server access (never expose the service role key to Vite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Arkesel SMS (get from: Arkesel Dashboard → SMS API → API Keys)
ARKESEL_API_KEY=your-arkesel-api-key-here
ARKESEL_SANDBOX=true

# Secure admin session (server-only)
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Reliable bulk SMS rollout (keep disabled through migration and pilot)
SMS_BULK_ENABLED=false
SMS_WORKER_SECRET=replace-with-a-random-worker-secret
SMS_CALLBACK_SECRET=replace-with-a-random-callback-secret
APP_URL=https://your-app.vercel.app
